{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TestRunnerContract",
  "description": "CLI interface and JSON reporting contract for the unified FlagManagment test harness",
  "cli_interface": {
    "command": "./scripts/run-all-tests.sh",
    "options": [
      {
        "flag": "--backend",
        "description": "Run Go backend unit and integration tests with race detector and coverage",
        "default": false
      },
      {
        "flag": "--frontend",
        "description": "Run React frontend Vitest component tests with coverage",
        "default": false
      },
      {
        "flag": "--e2e",
        "description": "Run Playwright end-to-end tests against Docker environment",
        "default": false
      },
      {
        "flag": "--sdk",
        "description": "Run SDK unit and OpenFeature conformance tests",
        "default": false
      },
      {
        "flag": "--perf",
        "description": "Run sub-millisecond in-memory evaluation latency benchmarks",
        "default": false
      },
      {
        "flag": "--all",
        "description": "Run all test tiers sequentially and generate consolidated report",
        "default": true
      },
      {
        "flag": "--json",
        "description": "Output consolidated test execution report to test-results.json",
        "default": false
      }
    ],
    "exit_codes": {
      "0": "All tests passed successfully with coverage thresholds met",
      "1": "One or more tests failed",
      "2": "Coverage threshold violation (Backend < 80% or Frontend < 70%)",
      "3": "Performance benchmark failure (p95 latency >= 1.0ms)"
    }
  },
  "output_format": {
    "type": "object",
    "required": ["run_id", "timestamp", "summary", "layers", "results"],
    "properties": {
      "run_id": { "type": "string", "format": "uuid" },
      "timestamp": { "type": "string", "format": "date-time" },
      "summary": {
        "type": "object",
        "required": ["total", "passed", "failed", "skipped", "duration_ms"],
        "properties": {
          "total": { "type": "integer" },
          "passed": { "type": "integer" },
          "failed": { "type": "integer" },
          "skipped": { "type": "integer" },
          "duration_ms": { "type": "number" },
          "backend_coverage_pct": { "type": "number" },
          "frontend_coverage_pct": { "type": "number" }
        }
      },
      "layers": {
        "type": "object",
        "properties": {
          "backend": { "type": "string", "enum": ["PASS", "FAIL", "SKIPPED"] },
          "frontend": { "type": "string", "enum": ["PASS", "FAIL", "SKIPPED"] },
          "e2e": { "type": "string", "enum": ["PASS", "FAIL", "SKIPPED"] },
          "sdk": { "type": "string", "enum": ["PASS", "FAIL", "SKIPPED"] },
          "perf": { "type": "string", "enum": ["PASS", "FAIL", "SKIPPED"] }
        }
      },
      "results": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["test_case_id", "status", "duration_ms"],
          "properties": {
            "test_case_id": { "type": "string" },
            "test_name": { "type": "string" },
            "file": { "type": "string" },
            "status": { "type": "string", "enum": ["PASS", "FAIL", "SKIP"] },
            "duration_ms": { "type": "number" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}

